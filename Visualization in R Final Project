# QUESTION 2:
# Are Subscribers mainly male or female?
# This second visualization is a stacked bar chart showing the breakdown of gender by user type.


# Cleaning up NY data set to assign "Unknown" to all blank Genders.
new.york.city$Gender[is.na(new.york.city$Gender) | new.york.city$Gender == ""] <- "Unknown"

# Cleaning up Chicago data set to assign "Unknown" to all blank Genders.
chicago$Gender[is.na(chicago$Gender) | chicago$Gender == ""] <- "Unknown"

# Washington does not have Gender data and will not be evaluated.

library(dplyr)
# Pulling only User.Type and Gender from each data set.
chi_gen_user <- chicago %>% select(User.Type, Gender)
ny_gen_user <- new.york.city %>% select(User.Type, Gender)


# Combining the variables above into one variable and grouping by User.Type.
all_gen_user <- rbind(chi_gen_user, ny_gen_user)

group_gen_user <- all_gen_user %>%
  group_by(User.Type, Gender) %>%
  summarize(count =n())


library(ggplot2)
#Creating the stacked bar chart.  I had issues with getting the Y axis labels and had to use both scipen and scale_y_continous
options(scipen = 999)
ggplot(group_gen_user, aes(x = User.Type, y = count, fill = Gender)) +
  geom_bar(stat = "identity") +
  labs(title = "User Types by Gender",
       x = "User Type",
       y = "Number of Users",
       fill = "Gender") +
  theme_minimal()+
  theme(plot.title = element_text(hjust = 0.5) +
  scale_y_continuous(labels = scales::comma, breaks = seq(0, max(group_gen_user$count), by = 500)))

#Summary of question 2 results:
# This shows that my subscribers are primarily male.


