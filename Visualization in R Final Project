#QUESTION 3:
# Are my subscribers primarily younger than other user types?
# My third visualization is a box plot showing the spread of age by user type.


library(dplyr)
# Pulling only User.Type and Gender from each data set.
chi_dob_user <- chicago %>% select(User.Type, Birth.Year)
ny_dob_user <- new.york.city %>% select(User.Type, Birth.Year)

# Washington does not have Birth.Year and will not be evaluated.

# Combining the variables above into one variable and converting year to age.
all_dob_user <- rbind(chi_dob_user, ny_dob_user)

all_dob_user$Age <- 2025 - all_dob_user$Birth.Year


library(ggplot2)

ggplot(all_dob_user, aes(x = User.Type, y = Age, fill = User.Type)) +
  geom_boxplot() + # Using a boxplot for this one to show the range and outliers.
  labs(title = "Age by User Type",
       x = "User Type",
       y = "Age",
       fill = "") +
  scale_y_continuous(breaks = seq(0, 150, by = 10)) + # Setting my Y axis to every 10 years.
  theme_minimal() +
  theme(plot.title = element_text(hjust = 0.5)) # Centering the title

#Summary of question 3 results:
