wa_dur_user <- washington %>% select(User.Type, Trip.Duration)

# Combining the variables above into one variable and grouping by User.Type.
all_dur_user <- rbind(chi_dur_user, ny_dur_user, wa_dur_user)

group_dur_user <- all_dur_user %>%
  group_by(User.Type) %>%
  summarize(avg_trip_dur = mean(Trip.Duration, na.rm = TRUE))

# Creating a bar chart to show the average trip duration by user type in descending order.
library (ggplot2)
ggplot(group_dur_user, aes(x = reorder(User.Type, -avg_trip_dur), y = avg_trip_dur, fill = User.Type)) +
  geom_bar(stat = "identity") +
  labs(title = "Average Trip Duration by User Type",
       x = "User Type",
       y = "Average Trip Duration (in seconds)",
       fill = "") + #Removing the header from the legend
  theme_minimal() +
  theme(plot.title = element_text(hjust = 0.5))

#Summary of question 1 results:
# This shows that Subscriber's average trips are shorter than other User Types.

